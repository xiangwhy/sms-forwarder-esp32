# ============================================================================
#  sdkconfig.defaults — SMS Forwarder v3.6.4
#  Arduino-as-component (双框架) 必须项 + USB Host + 我们用的功能开关
#  pio run 会把这些 merge 进 sdkconfig.esp32-s3-devkitc-1
# ============================================================================

# --- Arduino 双框架要求 ---
CONFIG_FREERTOS_HZ=1000
CONFIG_AUTOSTART_ARDUINO=y
CONFIG_ARDUINO_RUN_CORE1=y
CONFIG_ARDUINO_LOOP_CORE1=y

# --- USB Host (4G 模组走 USB CDC + RNDIS) ---
CONFIG_USB_HOST_ENABLED=y

# --- Flash / 分区 (8MB 板子) ---
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"

# --- 关 USB Serial JTAG (省得跟 USB Host 抢) ---
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
# CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG is not set
# CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG_ENABLED is not set

# --- HTTP client / OTA / mDNS 用到的 ---
CONFIG_ESP_HTTP_CLIENT_ENABLE_HTTPS=y
CONFIG_MBEDTLS_HARDWARE_SHA=y
# v4.0: 走 esp_crt_bundle 让 HTTPS 不用自己塞证书 (pushplus.plus)
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
# v4.0.3: FULL bundle (~130 张 ~70KB) → CMN (Mozilla 常用, pushplus 的 Let's Encrypt 在内)
# flash 减约 65KB
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_CMN=y

# v4.0.3: mbedTLS 精简 — 本项目只做 HTTPS client, 服务侧/重协商/PEM write/CSR/CRL/SHA512/CMAC 全关
CONFIG_MBEDTLS_TLS_CLIENT_ONLY=y
# CONFIG_MBEDTLS_TLS_SERVER is not set
# CONFIG_MBEDTLS_SSL_RENEGOTIATION is not set
# CONFIG_MBEDTLS_PEM_WRITE_C is not set
# CONFIG_MBEDTLS_X509_CRL_PARSE_C is not set
# CONFIG_MBEDTLS_X509_CSR_PARSE_C is not set
# CONFIG_MBEDTLS_SHA512_C is not set
# CONFIG_MBEDTLS_CMAC_C is not set
# CONFIG_MBEDTLS_SSL_OUT_CONTENT_LEN=2048
# CONFIG_MBEDTLS_SSL_IN_CONTENT_LEN=8192

# v4.0.3: -Os 替代 -Og, text 段缩小 15-25% (876KB → ~700KB)
# CONFIG_COMPILER_OPTIMIZATION_DEBUG is not set
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
# v4.0.3: GDB 桩关掉 (本项目无 JTAG 调试)
CONFIG_ESP_GDBSTUB_ENABLED=n

# --- 日志 ---
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_LOG_MAXIMUM_EQUALS_DEFAULT=y
